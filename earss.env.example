# Earss local environment template
#
# Usage:
#   cp earss.env.example earss.env
#   # edit earss.env as needed
#   mix deps.get && mix compile
#
# mix.exs loads (in order) when Mix evaluates the project:
#   1. earss.env
#   2. earss.env.local   (optional overrides; also gitignored)
#
# Rules:
#   - Lines starting with # are comments
#   - KEY=VALUE (optional single/double quotes around VALUE)
#   - Variables already set in the shell / CI / Docker are NOT overwritten
#
# Plugin deps are resolved at mix deps.get / compile time. After editing:
#   mix deps.get && mix compile
#
# You choose what to install. Only pin sources you trust.

# -----------------------------------------------------------------------------
# Optional source plugins (free-form Mix deps — no host catalog)
# -----------------------------------------------------------------------------
#
# Comma-separated specs. Each entry:
#
#   [app_name|]github:owner/repo[@ref]
#   [app_name|]git:https://host/repo.git[@ref]
#   [app_name|]hex:package[@requirement]
#   [app_name|]path:relative_or_absolute
#
# If app_name is omitted, it is inferred from the repo/package/path basename
# ("-" becomes "_"). @ref defaults to branch main; "v1.2.3" → tag; 40-hex → ref.
#
# Examples:
#   EARSS_SOURCE_PLUGINS=
#   EARSS_SOURCE_PLUGINS=github:ll1zt/earss_source_telegram@main
#   EARSS_SOURCE_PLUGINS=github:ll1zt/earss_source_telegram@v0.1.0,path:../my_plugin
#   EARSS_SOURCE_PLUGINS=my_app|git:https://git.example/plugins/foo.git@main
#
# Empty / unset → stock RSS/Atom/JSON Feed only.
EARSS_SOURCE_PLUGINS=github:ll1zt/earss_source_telegram@main

# Optional: force-register adapter modules if a plugin does not follow the
# earss_source_* → EarssSource*.Adapter convention (comma-separated).
# EARSS_SOURCE_ADAPTERS=EarssSourceTelegram.Adapter

# -----------------------------------------------------------------------------
# Production-oriented examples (usually set by the host / runtime.exs instead)
# -----------------------------------------------------------------------------

# DATABASE_URL=ecto://postgres:postgres@localhost/earss_dev
# SECRET_KEY_BASE=generate-with-mix-phx-gen-secret-or-openssl-rand-base64-48
# PORT=4000
# API_ENABLED=true
# POOL_SIZE=10
# TOKEN_MAX_AGE_SECS=2592000
