# Earss operator environment template
#
# Usage:
#   cp earss.env.example earss.env
#   # edit earss.env — only set what you need
#
# Loaded automatically from the project root:
#   1. earss.env
#   2. earss.env.local   (optional overrides; gitignored)
#
# Who reads what:
#   - mix.exs            → EARSS_SOURCE_PLUGINS (deps time)
#   - config/runtime.exs → all runtime keys below (every boot except MIX_ENV=test)
#
# Rules:
#   - Lines starting with # are comments
#   - KEY=VALUE (optional single/double quotes around VALUE)
#   - Process env already set (shell / CI / Docker) is NOT overwritten
#   - Unset keys keep defaults from config/config.exs (+ dev/test/prod files)
#
# After changing EARSS_SOURCE_PLUGINS:  mix deps.get && mix compile
# After changing runtime keys:          restart the app (iex -S mix / release)

# =============================================================================
# Mix deps — optional source plugins (free-form, no host catalog)
# =============================================================================
#
# Comma-separated specs:
#   [app_name|]github:owner/repo[@ref]
#   [app_name|]git:https://host/repo.git[@ref]
#   [app_name|]hex:package[@requirement]
#   [app_name|]path:relative_or_absolute
#
# Empty / unset → stock RSS/Atom/JSON Feed only.
EARSS_SOURCE_PLUGINS=github:ll1zt/earss_source_telegram@main

# Optional: force-register adapters that do not follow
# earss_source_* → EarssSource*.Adapter (comma-separated modules).
# EARSS_SOURCE_ADAPTERS=EarssSourceTelegram.Adapter

# -----------------------------------------------------------------------------
# Translation plugins (Goal 2 — docs/translate.md)
# -----------------------------------------------------------------------------
# Same spec grammar as EARSS_SOURCE_PLUGINS. Reference plugin:
#   earss_translate_openai (OpenAI/DeepSeek/Ollama/vLLM compatible).
# Empty / unset → translation disabled.
# EARSS_TRANSLATE_PLUGINS=path:../earss_translate_openai
# EARSS_TRANSLATE_OPENAI_API_KEY=sk-...
# EARSS_TRANSLATE_OPENAI_MODEL=gpt-4o-mini
#
# Optional: force-register translators that do not follow
# earss_translate_* → EarssTranslate*.Translator (comma-separated modules).
# EARSS_TRANSLATE_ADAPTERS=EarssTranslateOpenai.Translator
#
# Enrichment pipeline knobs (defaults shown):
#   TRANSLATE_MAX_CONCURRENCY=1            # provider calls in flight at once
#   TRANSLATE_PENDING_WORKER_INTERVAL_MS=60000  # retry cadence for pending entries
#   TRANSLATE_MAX_PENDING_RETRIES=5        # failures before an entry pauses (admin decision)

# =============================================================================
# Database (runtime)
# =============================================================================
# If DATABASE_URL is set it overrides host-specific Repo settings (dev.exs etc.).
# Required in production.

# DATABASE_URL=ecto://postgres:postgres@localhost/earss_dev
# POOL_SIZE=10

# =============================================================================
# HTTP API (runtime)
# =============================================================================
# SECRET_KEY_BASE is required in production (≥64 bytes recommended).
# Generate: openssl rand -base64 48

# SECRET_KEY_BASE=
# PORT=4000
# API_ENABLED=true
# TOKEN_MAX_AGE_SECS=2592000
# Set the Secure flag on the admin session cookie. Enable when the service
# is reached over HTTPS (Tailscale Funnel); leave unset for plain-HTTP
# tailnet access.
# HTTP_COOKIE_SECURE=1

# =============================================================================
# Inbound rate limiting (auth brute-force protection)
# =============================================================================
#
# X-Forwarded-For is trusted only from these proxy CIDRs (comma-separated).
# Behind Tailscale Funnel the proxy connects from the tailnet CGNAT range;
# set this so public clients are rate-limited by their real IP:
#   EARSS_RATE_LIMIT_TRUSTED_PROXIES=100.64.0.0/10
# Direct (non-proxied) exposure should leave it unset.
# EARSS_RATE_LIMIT_TRUSTED_PROXIES=

# =============================================================================
# Feed poller (runtime)
# =============================================================================
# POLLER_ENABLED=true
# POLLER_INTERVAL_MS=300000
# POLLER_BATCH_SIZE=50
# POLLER_MAX_CONCURRENCY=5
# POLLER_INITIAL_DELAY_MS=1000
# POLLER_TIMEOUT_MS=60000  # per-feed refresh timeout; paginated plugins may need more

# =============================================================================
# Retention policy + poller (runtime)
# =============================================================================
# RETENTION_READ_STATE_DAYS=90
# RETENTION_ENTRY_DAYS=180
# RETENTION_UNSUBSCRIBED_FEED_DAYS=30
# TTS audio expiry (docs/tts.md): ready requests older than N days lose the
# row and the file; orphans (no row, past the grace window) are swept.
# 0 disables audio expiry entirely.
# EARSS_TTS_AUDIO_RETENTION_DAYS=90
# EARSS_TTS_AUDIO_ORPHAN_GRACE_HOURS=24
# RETENTION_POLLER_ENABLED=true
# RETENTION_POLLER_INTERVAL_MS=86400000
# RETENTION_BATCH_SIZE=1000
# RETENTION_INITIAL_DELAY_MS=60000

# =============================================================================
# Refresh intervals in minutes (runtime, D7)
# =============================================================================
# REFRESH_MIN_INTERVAL=15
# REFRESH_MAX_INTERVAL=10080
# REFRESH_DEFAULT_INTERVAL=30

# =============================================================================
# Outbound HTTP for feed fetches (runtime)
# =============================================================================
# HTTP_RECEIVE_TIMEOUT_MS=15000
# HTTP_USER_AGENT=Earss/0.1 (+https://github.com/ll1zt/earss)

# =============================================================================
# Per-host crawl politeness (runtime) — Earss.Feeds.HostLimiter
# =============================================================================
# Caps concurrent outbound requests and enforces a min start interval per HTTP
# host (lowercase). 429/503 trigger a host cooldown (Retry-After or default).
# HOST_POLITENESS_ENABLED=true
# HOST_MAX_CONCURRENT=2
# HOST_MIN_INTERVAL_MS=1000
# HOST_DEFAULT_COOLDOWN_MS=60000
# HOST_CHECKOUT_TIMEOUT_MS=30000

# =============================================================================
# Single-operator credentials (runtime) — Earss.OperatorAuth
# =============================================================================
# One password for the admin UI login and the JSON API login.
# Unset -> every login attempt is rejected (bootstrap logs a warning).
# ADMIN_PASSWORD=change-me

# Fixed Fever api key (the Fever protocol requires an api_key parameter;
# NetNewsWire uses it). Unset -> Fever auth fails.
# FEVER_API_KEY=0123456789abcdef

# First-boot anchor row (runtime) — Earss.Bootstrap
# -----------------------------------------------------------------------------
# Seeds the single operator's anchor user row when the users table is empty
# (the table itself disappears in db-schema-v2).
# EARSS_BOOTSTRAP_ADMIN=true

# =============================================================================
# Listen-later controls (runtime) — Earss.API.ListenControls / Earss.TTS
# =============================================================================
# Injects a "🎧 Listen" control at the top of article content in reader
# clients; clicking it opens /tts/listen/... and records the request for the
# TTS pipeline.
#
# The link base defaults to the address the reader itself connects with
# (scheme + host of its requests), so flipping the flag is enough. Set an
# ABSOLUTE EARSS_TTS_PUBLIC_URL only when browsers must reach a different
# address than the reader's (reverse proxy, tunnel, custom domain).
# EARSS_TTS_LISTEN_CONTROLS=true
# EARSS_TTS_PUBLIC_URL=https://earss.example.net

# =============================================================================
# TTS synthesis + podcast feed (runtime) — Earss.TTS.Worker / Earss.TTS.Podcast
# =============================================================================
# Audio synthesis of requested entries and an Apple-Podcasts-compatible feed
# at /podcast/rss.xml. The podcast endpoints are unauthenticated by design
# (podcast clients and Apple's crawler cannot log in); the feed only exposes
# synthesized audio of your own listening queue.
#
# Enabling synthesis needs BOTH the worker flag and an audio directory;
# without either the worker never mounts. Providers are separate plugins
# (EARSS_TTS_PLUGINS, e.g. earss_tts_podcast) and configure themselves via
# their own EARSS_TTS_PODCAST_* environment.
# EARSS_TTS_WORKER_ENABLED=true
# EARSS_TTS_AUDIO_DIR=/var/lib/earss/audio
# EARSS_TTS_MAX_CONCURRENCY=1
# EARSS_TTS_WORKER_INTERVAL_MS=30000
# EARSS_TTS_MAX_RETRIES=5
