# Copy to project-root `.env` for docker compose:
#   cp .env.docker.example .env
#
# Compose reads `.env` automatically for variable substitution.
# Do not commit real secrets.

# Required — generate: openssl rand -base64 48
SECRET_KEY_BASE=

# Postgres (service `db`)
POSTGRES_USER=earss
POSTGRES_PASSWORD=earss
POSTGRES_DB=earss

# Host port mapped to the app
PORT=4000

# Image tag after build
EARSS_IMAGE=earss:local

# Optional: compile source plugins into the image (rebuild required)
# EARSS_SOURCE_PLUGINS=github:ll1zt/earss_source_telegram@main

# First-boot admin (empty users table only) — change after first login
EARSS_BOOTSTRAP_ADMIN=true
EARSS_DEFAULT_ADMIN_USER=admin
EARSS_DEFAULT_ADMIN_PASSWORD=changeme

# Runtime tuning
POOL_SIZE=5
POLLER_MAX_CONCURRENCY=3
HOST_MAX_CONCURRENT=2
HOST_MIN_INTERVAL_MS=1000
